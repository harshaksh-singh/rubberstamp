  {
    "name": "list_tickets",
    "app": "helpdesk",
    "description": "List tickets, newest first, optionally filtered by customer, status and priority.",
    "params": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only this customer's tickets",
          "title": "Customer Id"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "open",
                "pending",
                "resolved",
                "closed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only tickets in this status",
          "title": "Status"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "low",
                "normal",
                "high",
                "urgent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only tickets with this priority",
          "title": "Priority"
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "ListTicketsArgs",
      "type": "object"
    },
    "effect": "read",
    "idempotent": true,
    "id_params": [
      "customer_id"
    ],
    "roles": [
      "agent",
      "manager"
    ]
  },
