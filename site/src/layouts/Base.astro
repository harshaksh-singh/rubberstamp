---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  imageAlt: string;
}
const { title, description, imageAlt } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(`${base}og.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080b12" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let saved = null;
        try { saved = localStorage.getItem("rs-theme"); } catch {}
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "dark" : "light";
        // Elements that animate in stay hidden until the site script has set their start state, so they never
        // paint, vanish and fade back. Only with motion allowed; without JS the class is never set. If the script
        // has not run after 4 s, show everything.
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.classList.add("anim");
          setTimeout(() => root.classList.remove("anim"), 4000);
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
